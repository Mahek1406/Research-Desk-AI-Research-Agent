# =====================================================================
# ResearchDesk: Environment Configuration Template
# Copy this file to .env and configure your desired credentials.
# =====================================================================

# LLM Provider Configuration
# Supported providers: "openai", "groq", "gemini", "openrouter"
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini

# API Keys (Provide the key corresponding to your chosen LLM_PROVIDER)
OPENAI_API_KEY=your_openai_api_key_here
GROQ_API_KEY=your_groq_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Custom OpenAI-compatible Base URL (e.g. for Ollama or Local vLLM)
# LLM_BASE_URL=http://localhost:11434/v1

# Generation Parameters
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=3500
LLM_TIMEOUT_SECONDS=45

# Search Tool Configuration
# "duckduckgo" (Default: works out of the box with 0 API keys)
# "tavily" (High precision search for AI agents; requires TAVILY_API_KEY)
SEARCH_PROVIDER=duckduckgo
TAVILY_API_KEY=

# Retrieval Controls
MAX_SEARCH_RESULTS=5
MAX_SCRAPED_PAGES=3
HTTP_TIMEOUT_SECONDS=15
PAGE_CHAR_LIMIT=6000
MAX_TOOL_RETRIES=2

# Security & Prompt Injection Defense
STRIP_PROMPT_INJECTION_TOKENS=true
